# Copy this file to .env and fill in real values before running.
# Never commit the real .env file to version control.

# Server
PORT=4000
NODE_ENV=development

# Admin auth
# SESSION_SECRET signs admin login sessions - use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-before-deploying

ADMIN_EMAIL=admin@mttravel.com
# Not a plain password - a salted hash. The default below is the hash
# for "demo12345", generated with `node hash-password.js demo12345`.
# Generate your own the same way before deploying for real:
#   node hash-password.js "your-new-password"
ADMIN_PASSWORD_HASH=5416764a36d2a0b51ba8b2b982bf5d83:b9c30a460b6b5a226ed7911d5805dee7637c90469ab0f38d39882e2acf9804acb3fb17f8926cfe56b21ac4093ecf605dfb574340469dee1274abee016bbfcd8a

# CORS - the origin(s) your frontend is served from. Comma-separated for
# multiple. Example: https://www.mttravel.com,https://mttravel.com
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# Email - customer confirmations, owner new-reservation alerts, and status
# updates are all sent for real once these are set. Works with any standard
# SMTP provider: Gmail (smtp.gmail.com, port 587, use an App Password - not
# your normal password), SendGrid, Postmark, Mailgun, your own mail server,
# etc. Leave SMTP_HOST empty to disable email sending (reservations still
# work - they just won't trigger email until this is configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mttravelbodrum@gmail.com

# Where new-reservation notification emails are sent. Defaults to
# ADMIN_EMAIL above if not set separately.
OWNER_NOTIFICATION_EMAIL=

# Database - a single JSON file. Back it up by copying this file.
DB_PATH=./data/db.json
